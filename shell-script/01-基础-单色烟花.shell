// ─── 基础单色烟花 ───
// 最简洁的烟花定义，只用一个颜色

// 极简：纯红球
firework {
    name = "红球"
    size = 260
    color = #ff0043

    onDeath {
        burst 6 { color = inherit, life = 400, speed = 0.6 }
        flash(25)
    }
}

// 带闪光：金色
firework {
    name = "金星"
    size = 240
    color = #ffbf36
    glitter = light

    onDeath {
        burst 4 { color = inherit, life = 350, speed = 0.5 }
        flash(22)
    }
}

// 长拖尾：蓝色杨柳
firework {
    name = "蓝柳"
    size = 280
    life = 2500
    density = 0.5
    color = #1e7fff
    glitter = willow

    onDeath {
        burst 4 { color = inherit, life = 800, speed = 0.3 }
        flash(20)
    }
}

// 浓密拖尾：白色 thick
firework {
    name = "银尾"
    size = 300
    life = 1200
    color = #ffffff
    glitter = thick
    glitterColor = #ffbf36

    onDeath {
        burst 6 { color = #ffbf36, life = 450, speed = 0.5 }
        flash(30)
    }
}
