// ─── 频闪 (strobe) 与马尾 (horsetail) ───

// strobe - 频闪效果
firework {
    name = "频闪蓝"
    size = 300
    life = 1000
    color = #1e7fff
    glitter = heavy
    glitterColor = #ffffff
    strobe = true
    strobeColor = #ffffff

    onDeath {
        burst 6 { color = inherit, life = 450, speed = 0.6 }
        flash(35)
    }
}

// strobe + 多色
firework {
    name = "频闪霓虹"
    size = 320
    life = 900
    color = [#ff0043, #e60aff, #1e7fff]
    glitter = heavy
    glitterColor = #ffffff
    density = 1.1
    strobe = true
    strobeColor = #ffffff

    onDeath {
        burst 8 { color = inherit, life = 400, speed = 0.7 }
        flash(38)
    }
}

// horsetail - 马尾轨迹
firework {
    name = "马尾蓝"
    size = 250
    life = 2800
    color = #1e7fff
    glitter = medium
    glitterColor = #ffffff
    horsetail = true

    onDeath {
        burst 6 { color = inherit, life = 600, speed = 0.4 }
        flash(30)
    }
}

// horsetail + strobe 组合
firework {
    name = "马尾频闪"
    size = 260
    life = 2500
    color = [#ffbf36, #ffffff]
    glitter = medium
    glitterColor = #ffbf36
    horsetail = true
    strobe = true
    strobeColor = #ffffff

    onDeath {
        burst 5 { color = inherit, life = 500, speed = 0.5 }
        flash(32)
    }
}
