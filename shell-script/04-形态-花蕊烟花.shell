// ─── 花蕊烟花 ───
// pistil = true 会在内层叠加一个缩小的烟花，模拟花蕊效果

// 基础花蕊
firework {
    name = "金蕊红花"
    size = 280
    life = 1000
    color = #ff0043
    pistil = true
    pistilColor = #ffd700
    glitter = medium
    glitterColor = #ffffff

    onDeath {
        burst 5 { color = inherit, life = 450, speed = 0.5 }
        flash(28)
    }
}

// 多色 + 花蕊
firework {
    name = "彩蕊绽放"
    size = 300
    life = 1100
    color = [#ff0043, #e60aff, #1e7fff]
    pistil = true
    pistilColor = #ffd700
    glitter = heavy
    glitterColor = #ffffff
    density = 1.1

    onDeath {
        burst 6 { color = inherit, life = 450, speed = 0.6 }
        flash(30)
    }
}

// 花蕊 + 流苏
firework {
    name = "银蕊流苏"
    size = 320
    life = 1200
    color = [#9933ff, #e60aff]
    pistil = true
    pistilColor = #ffffff
    streamers = true
    glitter = medium
    glitterColor = #ffffff

    onDeath {
        arc 4 (6.283) { color = inherit, life = 500 }
        flash(28)
    }
}
