{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Firework Shell",
  "scopeName": "source.firework-shell",
  "patterns": [
    { "include": "#comments" },
    { "include": "#firework-block" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.firework-shell",
          "match": "//.*$"
        },
        {
          "name": "comment.block.firework-shell",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },

    "firework-block": {
      "name": "meta.block.firework.firework-shell",
      "begin": "\\b(firework)\\b",
      "beginCaptures": {
        "1": { "name": "keyword.control.firework.firework-shell" }
      },
      "end": "(?=\\bfirework\\b|\\z)",
      "patterns": [
        { "include": "#comments" },
        {
          "match": "(\\})",
          "name": "punctuation.definition.block.end.firework-shell"
        },
        { "include": "#property" },
        { "include": "#on-death-block" },
        { "include": "#invalid-prop" },
        {
          "name": "punctuation.definition.block.begin.firework-shell",
          "match": "\\{"
        }
      ]
    },

    "invalid-prop": {
      "patterns": [
        {
          "name": "invalid.deprecated.unknown-property.firework-shell",
          "match": "^\\s*(\\w+)\\s*(?==)(?!.*\\b(name|size|life|lifeVariation|density|starCount|color|secondColor|glitter|glitterColor|ring|horsetail|strobe|strobeColor|pistil|pistilColor|streamers|crossette|crackle|floral|fallingLeaves|onDeath)\\b)"
        },
        {
          "name": "invalid.illegal.multiple-assignments.firework-shell",
          "match": "=\\s*[\"#\\d\\w].+\\b\\w+\\s*=(?![^\\{]*(\\{|\\}))"
        }
      ]
    },

    "on-death-block": {
      "name": "meta.block.on-death.firework-shell",
      "begin": "\\b(onDeath)\\b",
      "beginCaptures": {
        "1": { "name": "keyword.control.on-death.firework-shell" }
      },
      "end": "(\\})(?=[\\s]*(?=\\bfirework\\b|\\z|$))",
      "endCaptures": {
        "1": { "name": "punctuation.definition.block.end.firework-shell" }
      },
      "patterns": [
        { "include": "#comments" },
        {
          "name": "punctuation.definition.block.begin.firework-shell",
          "match": "\\{"
        },
        { "include": "#action" }
      ]
    },

    "property": {
      "patterns": [
        {
          "name": "meta.property.firework-shell",
          "match": "\\b(name)\\s*(=)",
          "captures": {
            "1": { "name": "entity.name.tag.firework-shell" },
            "2": { "name": "keyword.operator.assignment.firework-shell" }
          }
        },
        {
          "name": "meta.property.firework-shell",
          "match": "\\b(size|life|lifeVariation|density|starCount)\\s*(=)",
          "captures": {
            "1": { "name": "variable.other.property.firework-shell" },
            "2": { "name": "keyword.operator.assignment.firework-shell" }
          }
        },
        {
          "name": "meta.property.firework-shell",
          "match": "\\b(color|secondColor|glitterColor|pistilColor|strobeColor)\\s*(=)",
          "captures": {
            "1": { "name": "variable.other.property.firework-shell" },
            "2": { "name": "keyword.operator.assignment.firework-shell" }
          }
        },
        {
          "name": "meta.property.firework-shell",
          "match": "\\b(glitter)\\s*(=)",
          "captures": {
            "1": { "name": "variable.other.property.firework-shell" },
            "2": { "name": "keyword.operator.assignment.firework-shell" }
          }
        },
        {
          "name": "meta.property.firework-shell",
          "match": "\\b(ring|horsetail|strobe|pistil|streamers|crossette|crackle|floral|fallingLeaves)\\s*(=)",
          "captures": {
            "1": { "name": "variable.other.property.firework-shell" },
            "2": { "name": "keyword.operator.assignment.firework-shell" }
          }
        },
        {
          "name": "constant.language.boolean.true.firework-shell",
          "match": "\\btrue\\b"
        },
        {
          "name": "constant.language.boolean.false.firework-shell",
          "match": "\\bfalse\\b"
        },
        {
          "name": "support.constant.builtin.random.firework-shell",
          "match": "\\brandom\\b"
        },
        {
          "name": "support.constant.builtin.inherit.firework-shell",
          "match": "\\binherit\\b"
        },
        {
          "name": "invalid.deprecated.boolean.firework-shell",
          "match": "(?<==)\\s*(?!true|false|random|inherit|\\d|#|\"|\\[|light|medium|heavy|thick|streamer|willow)(\\w+)(?!\\s*=)"
        },
        {
          "name": "invalid.illegal.trailing-garbage.firework-shell",
          "match": "\"[^\"]*\"\\s*[,;\\w#].*$"
        },
        { "include": "#hex-color" },
        { "include": "#string" },
        { "include": "#number" },
        { "include": "#color-list" },
        { "include": "#glitter-values" }
      ]
    },

    "action": {
      "patterns": [
        {
          "name": "meta.action.burst.firework-shell",
          "begin": "\\b(burst)\\b",
          "beginCaptures": {
            "1": { "name": "keyword.control.action.burst.firework-shell" }
          },
          "end": "(?=\\b(flash|arc|burst)\\b|^\\s*\\})",
          "patterns": [
            { "include": "#number" },
            { "include": "#action-options" },
            { "include": "#comments" }
          ]
        },
        {
          "name": "meta.action.flash.firework-shell",
          "begin": "\\b(flash)\\b",
          "beginCaptures": {
            "1": { "name": "keyword.control.action.flash.firework-shell" }
          },
          "end": "(?=\\b(flash|arc|burst)\\b|^\\s*\\})",
          "patterns": [
            { "include": "#flash-radius" },
            { "include": "#comments" }
          ]
        },
        {
          "name": "meta.action.arc.firework-shell",
          "begin": "\\b(arc)\\b",
          "beginCaptures": {
            "1": { "name": "keyword.control.action.arc.firework-shell" }
          },
          "end": "(?=\\b(flash|arc|burst)\\b|^\\s*\\})",
          "patterns": [
            { "include": "#number" },
            { "include": "#arc-angle" },
            { "include": "#action-options" },
            { "include": "#comments" }
          ]
        }
      ]
    },

    "action-options": {
      "name": "meta.options.action.firework-shell",
      "begin": "\\{",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.block.begin.firework-shell" }
      },
      "end": "\\}",
      "endCaptures": {
        "0": { "name": "punctuation.definition.block.end.firework-shell" }
      },
      "patterns": [
        { "include": "#comments" },
        {
          "match": "\\b(color)\\b\\s*(=)",
          "captures": {
            "1": { "name": "variable.other.property.firework-shell" },
            "2": { "name": "keyword.operator.assignment.firework-shell" }
          }
        },
        {
          "match": "\\b(life|speed)\\b\\s*(=)",
          "captures": {
            "1": { "name": "variable.other.property.firework-shell" },
            "2": { "name": "keyword.operator.assignment.firework-shell" }
          }
        },
        { "include": "#hex-color" },
        { "include": "#string" },
        { "include": "#number" },
        { "include": "#color-list" },
        {
          "name": "support.constant.builtin.inherit.firework-shell",
          "match": "\\binherit\\b"
        },
        {
          "name": "punctuation.separator.comma.firework-shell",
          "match": ","
        }
      ]
    },

    "flash-radius": {
      "name": "meta.radius.flash.firework-shell",
      "begin": "\\(",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.parameters.begin.firework-shell" }
      },
      "end": "\\)",
      "endCaptures": {
        "0": { "name": "punctuation.definition.parameters.end.firework-shell" }
      },
      "patterns": [
        { "include": "#number" }
      ]
    },

    "arc-angle": {
      "name": "meta.angle.arc.firework-shell",
      "begin": "\\(",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.parameters.begin.firework-shell" }
      },
      "end": "\\)",
      "endCaptures": {
        "0": { "name": "punctuation.definition.parameters.end.firework-shell" }
      },
      "patterns": [
        { "include": "#number" }
      ]
    },

    "hex-color": {
      "patterns": [
        {
          "name": "constant.other.color.hex.valid.firework-shell",
          "match": "#(?:[0-9a-fA-F]{6}|[0-9a-fA-F]{8})\\b"
        },
        {
          "name": "constant.other.color.hex.short.firework-shell",
          "match": "#[0-9a-fA-F]{3}\\b"
        },
        {
          "name": "invalid.illegal.color.hex.firework-shell",
          "match": "#[0-9a-fA-F]{1,2}(?![0-9a-fA-F])\\b|#[0-9a-fA-F]{4,5}(?![0-9a-fA-F])\\b|#[0-9a-fA-F]{7}(?![0-9a-fA-F])\\b|#[0-9a-fA-F]{9,}"
        }
      ]
    },

    "color-list": {
      "name": "meta.array.color.firework-shell",
      "begin": "\\[",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.array.begin.firework-shell" }
      },
      "end": "\\]",
      "endCaptures": {
        "0": { "name": "punctuation.definition.array.end.firework-shell" }
      },
      "patterns": [
        { "include": "#hex-color" },
        { "include": "#string" },
        {
          "name": "punctuation.separator.comma.firework-shell",
          "match": ","
        },
        {
          "name": "invalid.illegal.missing-comma.firework-shell",
          "match": "(?<=[^\\s,\\]])(?=\\s+[#\"])"
        }
      ]
    },

    "glitter-values": {
      "name": "support.type.glitter.firework-shell",
      "match": "\\b(light|medium|heavy|thick|streamer|willow)\\b"
    },

    "string": {
      "name": "string.quoted.double.firework-shell",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.firework-shell",
          "match": "\\\\."
        }
      ]
    },

    "number": {
      "name": "constant.numeric.firework-shell",
      "match": "\\b-?[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?\\b"
    }
  }
}
