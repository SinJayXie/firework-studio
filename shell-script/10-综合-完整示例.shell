// ─── 综合完整示例 ───
// 涵盖所有属性和效果组合

// 极简：参数最少但效果可看的烟花
firework {
    name = "随机色"
}

// random 颜色
firework {
    name = "随机惊喜"
    size = 300
    color = random
    glitter = medium
}

// 直接指定星点数量（覆盖 density）
firework {
    name = "精确数量"
    size = 280
    starCount = 100
    color = [#ff0043, #ffbf36, #1e7fff]
    glitter = light
    glitterColor = #ffffff
}

// lifeVariation 控制存活时间随机浮动
firework {
    name = "时间浮动"
    size = 280
    life = 1000
    lifeVariation = 0.5
    color = [#00ff88, #00aaff]
    glitter = medium
}

// 全功能组合
firework {
    name = "全效帝王"
    size = 380
    life = 1200
    lifeVariation = 0.2
    density = 1.0
    color = [#ff0043, #ffbf36, #e60aff, #1e7fff, #ffffff]
    secondColor = #ffd700
    glitter = heavy
    glitterColor = #ffffff
    ring = true
    pistil = true
    pistilColor = #ffd700
    streamers = true
    strobe = true
    strobeColor = #ffffff

    onDeath {
        arc 8 (6.283) { color = inherit, life = 600 }
        burst 5 { color = #ffffff, life = 400, speed = 0.4 }
        burst 3 { color = #ffbf36, life = 300, speed = 0.25 }
        flash(48)
    }
}

// 低密度长持续
firework {
    name = "时间之雨"
    size = 260
    life = 3500
    density = 0.25
    color = [#ffd700, #ffbf36, #ffffff]
    glitter = willow

    onDeath {
        burst 4 { color = inherit, life = 800, speed = 0.2 }
        flash(20)
    }
}

// 高速密集爆发
firework {
    name = "瞬爆"
    size = 300
    life = 500
    density = 1.6
    color = [#ffffff, #ccccff]
    glitter = heavy
    glitterColor = #ffffff
    strobe = true
    strobeColor = #ffffff

    onDeath {
        burst 14 { color = inherit, life = 200, speed = 1.0 }
        flash(55)
    }
}
